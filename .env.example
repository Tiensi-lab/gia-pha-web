# ==============================================================================
# GIA PHẢ GIA ĐÌNH — BIẾN MÔI TRƯỜNG CẤU HÌNH
# ==============================================================================

# 1. Chế độ phát triển nội bộ (Local Development Mode)
# Đặt là true để chạy đầy đủ chức năng với LocalStorage / In-Memory Mock (Không cần tài khoản Firebase)
NEXT_PUBLIC_LOCAL_DEV_MODE=true

# 2. Cấu hình Firebase Client SDK (Dành cho môi trường Production / Cloud)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gia-pha-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gia-pha-web
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gia-pha-web.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# 3. Cấu hình Firebase Admin SDK (Dành cho Server / API Route bảo mật)
# Lấy từ Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=gia-pha-web
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@gia-pha-web.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 4. UID Quản trị viên khởi tạo (Admin UID Allowlist)
ADMIN_PRIMARY_UID=admin-initial-uid
